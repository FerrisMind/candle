#version 450

#include "types.glsl"
#include "generic_unary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint idx = get_idx();

    if (idx >= p.ne) {
        return;
    }

    // Native bf16 sqrt: one pass, no f32 round-trip copies.
    const float val = STORAGE_TO_FLOAT(data_a[get_aoffset() + src0_idx(idx)]);
    data_d[get_doffset() + dst_idx(idx)] = STORAGE_FROM_FLOAT(sqrt(val));
}
