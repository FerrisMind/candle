#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// F64 native unary kernel. Uses the same push-constant layout as GgmlUnaryParams.
// All transcendental functions are manually implemented in double precision
// because GLSL/Vulkan has no double overloads for exp/log/sin/cos.

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012l;
    uint ne0_01mp;  uint ne0_01l;
    uint ne0_0mp;   uint ne0_0l;
    uint ne1_012mp; uint ne1_012l;
    uint ne1_01mp;  uint ne1_01l;
    uint ne1_0mp;   uint ne1_0l;
} p;

layout (binding = 0) readonly buffer A { double data_a[]; };
layout (binding = 1) writeonly buffer D { double data_d[]; };

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

uint get_idx() {
    return gl_GlobalInvocationID.z * 262144u + gl_GlobalInvocationID.y * 512u + gl_GlobalInvocationID.x;
}

uint get_aoffset() { return p.misalign_offsets >> 16u; }
uint get_doffset() { return p.misalign_offsets & 0xFFFFu; }

uint fastdiv(uint n, uint mp, uint L) {
    uint msbs, lsbs;
    umulExtended(n, mp, msbs, lsbs);
    return (msbs + n) >> L;
}

uint src0_idx(uint idx) {
    uint i03 = fastdiv(idx, p.ne0_012mp, p.ne0_012l);
    uint i03_offset = i03 * p.ne02 * p.ne01 * p.ne00;
    uint i02 = fastdiv(idx - i03_offset, p.ne0_01mp, p.ne0_01l);
    uint i02_offset = i02 * p.ne01 * p.ne00;
    uint i01 = fastdiv(idx - i03_offset - i02_offset, p.ne0_0mp, p.ne0_0l);
    uint i00 = idx - i03_offset - i02_offset - i01 * p.ne00;
    return i03 * p.nb03 + i02 * p.nb02 + i01 * p.nb01 + i00 * p.nb00;
}

uint dst_idx(uint idx) {
    uint i13 = fastdiv(idx, p.ne1_012mp, p.ne1_012l);
    uint i13_offset = i13 * p.ne12 * p.ne11 * p.ne10;
    uint i12 = fastdiv(idx - i13_offset, p.ne1_01mp, p.ne1_01l);
    uint i12_offset = i12 * p.ne11 * p.ne10;
    uint i11 = fastdiv(idx - i13_offset - i12_offset, p.ne1_0mp, p.ne1_0l);
    uint i10 = idx - i13_offset - i12_offset - i11 * p.ne10;
    return i13 * p.nb13 + i12 * p.nb12 + i11 * p.nb11 + i10 * p.nb10;
}

// ---- Manual double-precision transcendentals ----

// Construct 2^k as a double for integer k in [-1074, 1023].
// Returns +Inf for overflow, 0.0 for underflow.
double pow2_double(int k) {
    if (k > 1023) {
        // Overflow: return +Inf
        return 1.0LF / 0.0LF;
    }
    if (k < -1074) {
        // Underflow: return 0.0
        return 0.0LF;
    }
    if (k >= -1022) {
        // Normal range: exponent = 1023 + k, mantissa = 0
        uint hi = uint(1023 + k) << 20u;
        return packDouble2x32(uvec2(0u, hi));
    }
    // Subnormal range: 2^k = 2^(k+1074) * 2^-1074
    // mantissa bits = 1 << (k + 1074)
    uint mantissa = 1u << uint(k + 1074);
    return packDouble2x32(uvec2(mantissa, 0u));
}

// ln(2) split into high and low parts for accurate range reduction:
// ln(2) = 0.693147180559945309417232121458176568...
// ln2_hi = 0.693147180559945286226763982995180413... (53 bits)
// ln2_lo = 0.693147180559945309417232121458176568... - ln2_hi
const double LN2_HI = 0.6931471805599453LF;  // 0x1.62e42fefa39efp-1
const double LN2_LO = 2.3190468138462996e-17LF; // remainder

// 1/ln(2) = 1.442695040888963407359924681001892137...
const double INV_LN2 = 1.4426950408889634LF; // 0x1.71547652b82fep+0

// exp(x) for double, |x| < infinity.
// Method: k = round(x / ln2), r = x - k*ln2, exp(x) = 2^k * exp(r).
// exp(r) via Taylor series: sum_{n=0}^{13} r^n / n!
double exp_double(double x) {
    // Handle special cases
    if (isnan(x)) return x;
    if (x > 709.782712893384LF) return 1.0LF / 0.0LF; // overflow
    if (x < -745.1332191019411LF) return 0.0LF; // underflow

    double kd = round(x * INV_LN2);
    int k = int(kd);
    // r = x - k*ln2 computed with high precision split
    double r = (x - kd * LN2_HI) - kd * LN2_LO;

    // Taylor series for exp(r), |r| <= ln2/2 ≈ 0.3466
    // Horner: exp(r) ≈ 1 + r*(1 + r/2*(1 + r/3*(1 + ...)))
    double r2 = r * r;
    double r4 = r2 * r2;
    double r6 = r4 * r2;
    double r8 = r4 * r4;
    double r10 = r8 * r2;
    double r12 = r6 * r6;

    double num = 1.0LF
        + r * (1.0LF
        + r / 2.0LF * (1.0LF
        + r / 3.0LF * (1.0LF
        + r / 4.0LF * (1.0LF
        + r / 5.0LF * (1.0LF
        + r / 6.0LF * (1.0LF
        + r / 7.0LF * (1.0LF
        + r / 8.0LF * (1.0LF
        + r / 9.0LF * (1.0LF
        + r / 10.0LF * (1.0LF
        + r / 11.0LF * (1.0LF
        + r / 12.0LF * (1.0LF
        + r / 13.0LF))))))))))));

    return num * pow2_double(k);
}

// log(x) for double, x > 0.
// Method: x = m * 2^e with m in [sqrt(0.5), sqrt(2)).
// log(x) = e*ln(2) + log(m).
// log(m) = 2*atanh(z), z = (m-1)/(m+1), |z| <= 0.17157
// atanh(z) = z + z^3/3 + z^5/5 + ... + z^19/19
double log_double(double x) {
    if (x <= 0.0LF) {
        // NaN for x < 0, -Inf for x == 0
        return (x == 0.0LF) ? (-1.0LF / 0.0LF) : (0.0LF / 0.0LF);
    }
    if (isinf(x)) return x;

    // Extract exponent and mantissa via bit operations
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;

    // Extract exponent (bits 52-62) and mantissa (bits 0-51)
    int e = int((hi >> 20u) & 0x7FFu) - 1023;
    // Set exponent to 1023 (bias for 1.0) to get m in [1, 2)
    uint mantissa_hi = (hi & 0xFFFFFu) | (1023u << 20u);
    double m = packDouble2x32(uvec2(lo, mantissa_hi));

    // Adjust so m is in [sqrt(0.5), sqrt(2)) ≈ [0.7071, 1.4142)
    if (m < 0.7071067811865476LF) {
        m *= 2.0LF;
        e -= 1;
    }

    // z = (m-1)/(m+1)
    double z = (m - 1.0LF) / (m + 1.0LF);
    double z2 = z * z;

    // atanh(z) = z + z^3/3 + z^5/5 + ... + z^19/19
    double z4 = z2 * z2;
    double z8 = z4 * z4;
    double z16 = z8 * z8;

    double atanh = z
        + z2 * z / 3.0LF
        + z4 * z / 5.0LF
        + z4 * z2 * z / 7.0LF
        + z8 * z / 9.0LF
        + z8 * z2 * z / 11.0LF
        + z8 * z4 * z / 13.0LF
        + z8 * z4 * z2 * z / 15.0LF
        + z16 * z / 17.0LF
        + z16 * z2 * z / 19.0LF;

    // log(m) = 2 * atanh(z)
    double log_m = 2.0LF * atanh;

    return double(e) * LN2_HI + double(e) * LN2_LO + log_m;
}

// pi/2 split into high and low parts for range reduction
const double PI_HI = 1.5707963267948966LF;   // pi/2 high
const double PI_LO = 6.123233995736766e-17LF; // pi/2 low
const double TWO_OVER_PI = 0.6366197723675814LF; // 2/pi

// sin(x) for double, |x| limited to ~1e6 for accuracy.
// Method: range reduction to [-pi/4, pi/4], then Taylor series.
double sin_double(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return 0.0LF / 0.0LF; // NaN

    // Handle negative: sin(-x) = -sin(x)
    double sign = 1.0LF;
    if (x < 0.0LF) {
        x = -x;
        sign = -1.0LF;
    }

    // Range reduction: k = round(x * (2/pi)), r = x - k*(pi/2)
    double kd = round(x * TWO_OVER_PI);
    int k = int(kd);
    double r = (x - kd * PI_HI) - kd * PI_LO;
    int quadrant = k & 3;

    // Taylor series for sin(r) or cos(r) depending on quadrant, |r| <= pi/4
    double r2 = r * r;
    double r4 = r2 * r2;
    double r6 = r4 * r2;
    double r8 = r4 * r4;
    double r10 = r8 * r2;
    double r12 = r6 * r6;
    double r14 = r8 * r6;
    double r16 = r8 * r8;

    // sin(r) ≈ r - r^3/6 + r^5/120 - r^7/5040 + ... + r^17/17!
    double sin_r = r
        - r2 * r / 6.0LF
        + r4 * r / 120.0LF
        - r6 * r / 5040.0LF
        + r8 * r / 362880.0LF
        - r10 * r / 39916800.0LF
        + r12 * r / 6227020800.0LF
        - r14 * r / 1307674368000.0LF
        + r16 * r / 355687428096000.0LF;

    // cos(r) ≈ 1 - r^2/2 + r^4/24 - r^6/720 + ... - r^16/16!
    double cos_r = 1.0LF
        - r2 / 2.0LF
        + r4 / 24.0LF
        - r6 / 720.0LF
        + r8 / 40320.0LF
        - r10 / 3628800.0LF
        + r12 / 479001600.0LF
        - r14 / 87178291200.0LF
        + r16 / 20922789888000.0LF;

    double result;
    if (quadrant == 0) {
        result = sin_r;
    } else if (quadrant == 1) {
        result = cos_r;
    } else if (quadrant == 2) {
        result = -sin_r;
    } else {
        result = -cos_r;
    }
    return sign * result;
}

// cos(x) = sin(pi/2 - x)
double cos_double(double x) {
    return sin_double(PI_HI + PI_LO - x);
}

// Manual double-precision erf via Horner's method (approximation).
// Uses exp_double for the exp(-x^2) factor.
double erf_double(double x) {
    double t = 1.0LF / (1.0LF + 0.3275911LF * abs(x));
    double y = 1.0LF - (((((1.061405429LF * t - 1.453152027LF) * t) + 1.421413741LF) * t - 0.284496736LF) * t + 0.254829592LF) * t * exp_double(-x * x);
    return sign(x) * y;
}

// Manual double-precision tanh: (exp(2x) - 1) / (exp(2x) + 1)
double tanh_double(double x) {
    double e2x = exp_double(2.0LF * x);
    return (e2x - 1.0LF) / (e2x + 1.0LF);
}

double apply_unary_f64(int op, double x) {
    switch (op) {
        case 0: return exp_double(x);
        case 1: return log_double(x);
        case 2: return sin_double(x);
        case 3: return cos_double(x);
        case 4: return abs(x);
        case 5: return -x;
        case 6: return 1.0LF / x;
        case 7: return x * x;
        case 8: return sqrt(x);
        case 9: {
            // gelu: x * 0.5 * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
            double x3 = x * x * x;
            double inner = 0.7978845608028654LF * (x + 0.044715LF * x3);
            return x * 0.5LF * (1.0LF + tanh_double(inner));
        }
        case 10: {
            // gelu_erf: x * 0.5 * (1 + erf(x / sqrt(2)))
            return x * 0.5LF * (1.0LF + erf_double(x * 0.7071067811865475LF));
        }
        case 11: return erf_double(x);
        case 12: return max(x, 0.0LF);
        case 13: {
            // silu: x * sigmoid(x) = x / (1 + exp(-x))
            return x / (1.0LF + exp_double(-x));
        }
        case 14: return tanh_double(x);
        case 15: return floor(x);
        case 16: return ceil(x);
        case 17: return roundEven(x);
        case 18: return sign(x);
        default: return x;
    }
}

void main() {
    uint idx = get_idx();
    if (idx >= p.ne) {
        return;
    }
    double val = data_a[get_aoffset() + src0_idx(idx)];
    int op = int(p.param1);
    data_d[get_doffset() + dst_idx(idx)] = apply_unary_f64(op, val);
}