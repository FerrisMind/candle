#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// F64 native unary kernel. Uses the same push-constant layout as GgmlUnaryParams.

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012l;
    uint ne0_01mp;  uint ne0_01l;
    uint ne0_0mp;   uint ne0_0l;
    uint ne1_012mp; uint ne1_012l;
    uint ne1_01mp;  uint ne1_01l;
    uint ne1_0mp;   uint ne1_0l;
} p;

layout (binding = 0) readonly buffer A { double data_a[]; };
layout (binding = 1) writeonly buffer D { double data_d[]; };

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

uint get_idx() {
    return gl_GlobalInvocationID.z * 262144u + gl_GlobalInvocationID.y * 512u + gl_GlobalInvocationID.x;
}

uint get_aoffset() { return p.misalign_offsets >> 16u; }
uint get_doffset() { return p.misalign_offsets & 0xFFFFu; }

uint fastdiv(uint n, uint mp, uint L) {
    uint msbs, lsbs;
    umulExtended(n, mp, msbs, lsbs);
    return (msbs + n) >> L;
}

uint src0_idx(uint idx) {
    uint i03 = fastdiv(idx, p.ne0_012mp, p.ne0_012l);
    uint i03_offset = i03 * p.ne02 * p.ne01 * p.ne00;
    uint i02 = fastdiv(idx - i03_offset, p.ne0_01mp, p.ne0_01l);
    uint i02_offset = i02 * p.ne01 * p.ne00;
    uint i01 = fastdiv(idx - i03_offset - i02_offset, p.ne0_0mp, p.ne0_0l);
    uint i00 = idx - i03_offset - i02_offset - i01 * p.ne00;
    return i03 * p.nb03 + i02 * p.nb02 + i01 * p.nb01 + i00 * p.nb00;
}

uint dst_idx(uint idx) {
    uint i13 = fastdiv(idx, p.ne1_012mp, p.ne1_012l);
    uint i13_offset = i13 * p.ne12 * p.ne11 * p.ne10;
    uint i12 = fastdiv(idx - i13_offset, p.ne1_01mp, p.ne1_01l);
    uint i12_offset = i12 * p.ne11 * p.ne10;
    uint i11 = fastdiv(idx - i13_offset - i12_offset, p.ne1_0mp, p.ne1_0l);
    uint i10 = idx - i13_offset - i12_offset - i11 * p.ne10;
    return i13 * p.nb13 + i12 * p.nb12 + i11 * p.nb11 + i10 * p.nb10;
}

// Manual double-precision erf via Horner's method (approximation).
// Not all GLSL implementations provide erf(double).
double erf_double(double x) {
    double t = 1.0LF / (1.0LF + 0.3275911LF * abs(x));
    double y = 1.0LF - (((((1.061405429LF * t - 1.453152027LF) * t) + 1.421413741LF) * t - 0.284496736LF) * t + 0.254829592LF) * t * exp(-x * x);
    return sign(x) * y;
}

// Manual double-precision tanh: (exp(2x) - 1) / (exp(2x) + 1)
double tanh_double(double x) {
    double e2x = exp(2.0LF * x);
    return (e2x - 1.0LF) / (e2x + 1.0LF);
}

double apply_unary_f64(int op, double x) {
    switch (op) {
        case 0: return exp(x);
        case 1: return log(x);
        case 2: return sin(x);
        case 3: return cos(x);
        case 4: return abs(x);
        case 5: return -x;
        case 6: return 1.0LF / x;
        case 7: return x * x;
        case 8: return sqrt(x);
        case 9: {
            double x3 = x * x * x;
            double inner = 0.7978845608028654LF * (x + 0.044715LF * x3);
            return x * 0.5LF * (1.0LF + tanh_double(inner));
        }
        case 10: {
            return x * 0.5LF * (1.0LF + erf_double(x * 0.7071067811865475LF));
        }
        case 11: return erf_double(x);
        case 12: return max(x, 0.0LF);
        case 13: return x / (1.0LF + exp(-x));
        case 14: return tanh_double(x);
        case 15: return floor(x);
        case 16: return ceil(x);
        case 17: return roundEven(x);
        case 18: return sign(x);
        default: return x;
    }
}

void main() {
    uint idx = get_idx();
    if (idx >= p.ne) {
        return;
    }
    double val = data_a[get_aoffset() + src0_idx(idx)];
    int op = int(p.param1);
    data_d[get_doffset() + dst_idx(idx)] = apply_unary_f64(op, val);
}