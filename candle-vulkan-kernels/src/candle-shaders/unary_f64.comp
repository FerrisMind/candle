#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// F64 native unary kernel. Uses the same push-constant layout as GgmlUnaryParams.

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012l;
    uint ne0_01mp;  uint ne0_01l;
    uint ne0_0mp;   uint ne0_0l;
    uint ne1_012mp; uint ne1_012l;
    uint ne1_01mp;  uint ne1_01l;
    uint ne1_0mp;   uint ne1_0l;
} p;

layout (binding = 0) readonly buffer A { double data_a[]; };
layout (binding = 1) writeonly buffer D { double data_d[]; };

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

uint get_idx() {
    return gl_GlobalInvocationID.z * 262144u + gl_GlobalInvocationID.y * 512u + gl_GlobalInvocationID.x;
}

uint get_aoffset() { return p.misalign_offsets >> 16u; }
uint get_doffset() { return p.misalign_offsets & 0xFFFFu; }

uint fastdiv(uint n, uint mp, uint L) {
    uint msbs, lsbs;
    umulExtended(n, mp, msbs, lsbs);
    return (msbs + n) >> L;
}

uint src0_idx(uint idx) {
    uint i03 = fastdiv(idx, p.ne0_012mp, p.ne0_012l);
    uint i03_offset = i03 * p.ne02 * p.ne01 * p.ne00;
    uint i02 = fastdiv(idx - i03_offset, p.ne0_01mp, p.ne0_01l);
    uint i02_offset = i02 * p.ne01 * p.ne00;
    uint i01 = fastdiv(idx - i03_offset - i02_offset, p.ne0_0mp, p.ne0_0l);
    uint i00 = idx - i03_offset - i02_offset - i01 * p.ne00;
    return i03 * p.nb03 + i02 * p.nb02 + i01 * p.nb01 + i00 * p.nb00;
}

uint dst_idx(uint idx) {
    uint i13 = fastdiv(idx, p.ne1_012mp, p.ne1_012l);
    uint i13_offset = i13 * p.ne12 * p.ne11 * p.ne10;
    uint i12 = fastdiv(idx - i13_offset, p.ne1_01mp, p.ne1_01l);
    uint i12_offset = i12 * p.ne11 * p.ne10;
    uint i11 = fastdiv(idx - i13_offset - i12_offset, p.ne1_0mp, p.ne1_0l);
    uint i10 = idx - i13_offset - i12_offset - i11 * p.ne10;
    return i13 * p.nb13 + i12 * p.nb12 + i11 * p.nb11 + i10 * p.nb10;
}

// ---------------------------------------------------------------------------
// Manual double-precision transcendentals
// GLSL's built-in exp/log/sin/cos only support float; double variants require
// GL_EXT_shader_explicit_arithmetic_types_float64 but are not universally
// available. We implement them here via polynomial/minimax approximations.
// ---------------------------------------------------------------------------

// Constants
const double LN2_HI = 0.693147180559945309417232121458176568LF;  // 0x1.62e42fee00000p-1
const double LN2_LO = 1.908214929270939946e-10LF;               // 0x1.a39ef35793c76p-43
const double INV_LN2 = 1.442695040888963387004650940070860088LF; // 1/ln(2)
const double PI = 3.14159265358979311599796346854418516LF;
const double TWO_PI = 6.28318530717958623199592693708837033LF;
const double PI_OVER_2 = 1.57079632679489655799898173427209258LF;
const double PI_OVER_4 = 0.78539816339744827899949086713604629LF;
const double INV_PI = 0.318309886183790671537767526745028724LF;

// exp(x): k = round(x / ln2), r = x - k*ln2, then exp(r)*2^k via Taylor
double exp_double(double x) {
    // Handle special cases
    if (x < -745.0LF) return 0.0LF;
    if (x > 709.0LF)  return 1.0LF / 0.0LF; // +inf

    // Range reduction: k = round(x / ln2)
    double kf = floor(x * INV_LN2 + 0.5LF);
    int k = int(kf);
    double r = x - kf * LN2_HI - kf * LN2_LO;

    // Taylor series for exp(r) when |r| <= ln2/2 ~ 0.3466
    double r2 = r * r;
    double r3 = r2 * r;
    double r4 = r3 * r;
    double exp_r = 1.0LF + r + r2 * 0.5LF + r3 * 0.1666666666666666666666666666666667LF + r4 * 0.04166666666666666666666666666666667LF;

// Build 2^k via packDouble2x32
    uvec2 bits = uvec2(0, uint(k + 1023) << 20u);
    double pow2 = packDouble2x32(bits);

    return exp_r * pow2;
}

// log(x) via atanh series: log(x) = 2 * atanh((x-1)/(x+1))
double log_double(double x) {
    if (x <= 0.0LF) return 0.0LF / 0.0LF; // NaN
    double y = (x - 1.0LF) / (x + 1.0LF);
    double y2 = y * y;
    double y4 = y2 * y2;
    double y6 = y4 * y2;
    double y8 = y4 * y4;
    double y10 = y8 * y2;
    double y12 = y6 * y6;
    double y14 = y12 * y2;
    // atanh(y) = y + y^3/3 + y^5/5 + y^7/7 + y^9/9 + y^11/11 + y^13/13 + y^15/15
    double atanh_y = y * (1.0LF
        + y2 * (0.3333333333333333333333333333333333LF
        + y2 * (0.2LF
        + y2 * (0.1428571428571428571428571428571429LF
        + y2 * (0.1111111111111111111111111111111111LF
        + y2 * (0.09090909090909090909090909090909091LF
        + y2 * (0.07692307692307692307692307692307692LF
        + y2 *  0.06666666666666666666666666666666667LF)))))));
    return 2.0LF * atanh_y;
}

// sin(x) via quadrant reduction
double sin_double(double x) {
    // Reduce to [-pi/2, pi/2]
    double kf = floor(x * INV_PI + 0.5LF);
    int k = int(kf);
    x = x - kf * PI;

    // Taylor series for sin(x) when |x| <= pi/2
    double x2 = x * x;
    double x3 = x2 * x;
    double x4 = x3 * x;
    double x5 = x3 * x2;
    double x6 = x4 * x2;
    double x7 = x4 * x3;
    double x9 = x7 * x2;
    double x11 = x9 * x2;
    double x13 = x11 * x2;
    double result = x
        - x3 * 0.1666666666666666666666666666666667LF
        + x5 * 0.008333333333333333333333333333333333LF
        - x7 * 0.0001984126984126984126984126984126984LF
        + x9 * 2.755731922398589065255731922398589e-6LF
        - x11 * 2.505210838544171877505210838544172e-8LF
        + x13 * 1.605904383682161459939237717015494e-10LF;

    return (k & 1) == 0 ? result : -result;
}

// cos(x) = sin(x + pi/2)
double cos_double(double x) {
    return sin_double(x + PI_OVER_2);
}

// Manual double-precision erf via Horner's method (approximation).
double erf_double(double x) {
    double t = 1.0LF / (1.0LF + 0.3275911LF * abs(x));
    double y = 1.0LF - (((((1.061405429LF * t - 1.453152027LF) * t) + 1.421413741LF) * t - 0.284496736LF) * t + 0.254829592LF) * t * exp_double(-x * x);
    return sign(x) * y;
}

// Manual double-precision tanh: (exp(2x) - 1) / (exp(2x) + 1)
double tanh_double(double x) {
    double e2x = exp_double(2.0LF * x);
    return (e2x - 1.0LF) / (e2x + 1.0LF);
}

double apply_unary_f64(int op, double x) {
    switch (op) {
        case 0: return exp_double(x);
        case 1: return log_double(x);
        case 2: return sin_double(x);
        case 3: return cos_double(x);
        case 4: return abs(x);
        case 5: return -x;
        case 6: return 1.0LF / x;
        case 7: return x * x;
        case 8: return sqrt(x);
        case 9: {
            double x3 = x * x * x;
            double inner = 0.7978845608028654LF * (x + 0.044715LF * x3);
            return x * 0.5LF * (1.0LF + tanh_double(inner));
        }
        case 10: {
            return x * 0.5LF * (1.0LF + erf_double(x * 0.7071067811865475LF));
        }
        case 11: return erf_double(x);
        case 12: return max(x, 0.0LF);
        case 13: return x / (1.0LF + exp_double(-x));
        case 14: return tanh_double(x);
        case 15: return floor(x);
        case 16: return ceil(x);
        case 17: return roundEven(x);
        case 18: return sign(x);
        default: return x;
    }
}

void main() {
    uint idx = get_idx();
    if (idx >= p.ne) {
        return;
    }
    double val = data_a[get_aoffset() + src0_idx(idx)];
    int op = int(p.param1);
    data_d[get_doffset() + dst_idx(idx)] = apply_unary_f64(op, val);
}